---
// Kendi barındırdığımız (R2 gibi) video dosyalarını, FramedMedia ile aynı
// çerçeve/köşe dilini kullanarak oynatan native HTML5 video player.
interface Props {
  src: string;
  poster?: string;
  variant?: "reel" | "square" | "wide";
  class?: string;
}

const { src, poster, variant = "reel", class: className } = Astro.props;
---

<div class:list={["video-frame", className]} data-variant={variant}>
  <video src={src} poster={poster} controls preload="metadata" playsinline>
    Tarayıcınız video oynatmayı desteklemiyor.
  </video>
  <span class="ring" aria-hidden="true"></span>
</div>

<style>
  .video-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-2);
    box-shadow: var(--shadow-soft);
  }

  .video-frame[data-variant="reel"] {
    aspect-ratio: 9 / 16;
  }

  .video-frame[data-variant="square"] {
    aspect-ratio: 1 / 1;
  }

  .video-frame[data-variant="wide"] {
    aspect-ratio: 16 / 10;
  }

  .video-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #000;
  }

  .ring {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    border: 1px solid var(--color-border);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15);
  }
</style>
