---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FramedMedia from "../components/FramedMedia.astro";
import AutoSlider from "../components/AutoSlider.astro";
import { person, seo } from "../config/site";

const aiEntries = await getCollection("ai-content");

// Slider, her kategoriden seçilen (ilk iki) görselden oluşur
const sliderItems = aiEntries.flatMap((entry) =>
  entry.data.images.slice(0, 2).map((src, index) => ({
    src,
    alt: `${entry.data.title} #${index + 1}`,
    href: `/ai-icerikleri/${entry.id}`,
    caption: entry.data.title,
  }))
);
---

<BaseLayout title={`AI İçerikleri — ${person.name}`} description={seo.description}>
  <section class="container page-header">
    <h1>AI <em>İçerikleri</em></h1>
    <p class="page-intro">
      AI destekli görsel çalışmalarımı kategorilere ayırdım. Her kategori,
      o tema altında ürettiğim tüm görselleri içerir — detayları görmek için
      bir kategoriye tıklayın.
    </p>
  </section>

  <section class="slider-section">
    <AutoSlider items={sliderItems} variant="square" speed={44} />
  </section>

  <section class="container gallery-section">
    <div class="bento-grid">
      {
        aiEntries.map((entry) => (
          <FramedMedia
            class={`bento-${entry.data.size}`}
            variant="square"
            src={entry.data.images[0]}
            alt={entry.data.title}
            href={`/ai-icerikleri/${entry.id}`}
          >
            <span class="chip label-mono">
              {entry.data.title} · {entry.data.images.length} görsel
            </span>
          </FramedMedia>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .page-header h1 {
    font-size: var(--fs-2xl);
  }

  .page-intro {
    max-width: 40rem;
    font-size: var(--fs-md);
  }

  .slider-section {
    padding-block: var(--space-sm) var(--space-lg);
  }

  .gallery-section {
    padding-block: var(--space-md) var(--space-2xl);
  }

  .chip {
    display: inline-block;
    background-color: var(--color-overlay);
    color: var(--color-accent-strong);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
</style>
